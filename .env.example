# ========================================
# ATHENA - Exemplo de Configurações de Ambiente
# ========================================
# Copie este arquivo para .env e preencha com suas credenciais reais
# ========================================

# --- APIs de IA ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Banco de Dados Postgres ---
DATABASE_URL=postgresql+asyncpg://athena_user:athena_password@localhost:5432/athena_db
USE_IN_MEMORY_DB=false

# --- Qdrant (Vector Database) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- BFF (Backend for Frontend) ---
PORT=3000
BRAIN_API_URL=http://localhost:8000
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here

# --- Feature Flags ---
ALLOW_FAKE_FALLBACK=false

# --- Desenvolvimento ---
LOG_LEVEL=INFO
ENVIRONMENT=development
