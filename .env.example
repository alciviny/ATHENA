# ========================================
# ATHENA - Exemplo de Configurações de Ambiente
# ========================================
# Copie este arquivo para .env e preencha com suas credenciais reais
# ========================================

# --- APIs de IA ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Segurança ---
JWT_SECRET_KEY=your_very_long_and_secure_jwt_secret_key_here_minimum_32_characters

# --- Ambiente ---
ENVIRONMENT=development

# --- Banco de Dados Postgres ---
DB_USER=athena_user
DB_PASSWORD=your_secure_password_here
DB_NAME=athena
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}
USE_IN_MEMORY_DB=false

# --- Qdrant (Vector Database) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- BFF (Backend for Frontend) ---
PORT=3000
BRAIN_API_URL=http://localhost:8000
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here

# --- Feature Flags ---
ALLOW_FAKE_FALLBACK=false

# --- Desenvolvimento ---
LOG_LEVEL=INFO
ENVIRONMENT=development
